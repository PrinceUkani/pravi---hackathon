{
  "name": "infraro-root",
  "version": "1.0.0",
  "type": "module",
  "description": "Infraro - Manage Every Asset. Track Every Lifecycle.",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"emerald,yellow\" \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "seed": "cd server && npm run seed",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "build": "cd client && npm run build",
    "test": "cd server && npm test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
